  "solutions": {
    "causeway": {
      "name": "Elevated causeway segment",
      "description": "Raise the road on a causeway over the marsh so tidal flow and wetland habitat reconnect beneath it and wildlife stays off the roadway."
    },
    "overpass": {
      "name": "Vegetated wildlife overpass",
      "description": "A landscaped bridge over the highway that large mammals can cross on natural ground."
    },
    "underpass": {
      "name": "Wildlife undercrossing or enlarged culvert",
      "description": "A wide, open passage under the road, such as a bridge span or box culvert, for mid-sized mammals."
    },
    "small_culvert": {
      "name": "Small-animal culverts with cover",
      "description": "Small, dry culverts with vegetation or cover at the entrances so small mammals can pass under the road."
    },
    "dry_ledge": {
      "name": "Waterway crossing with dry banks or ledges",
      "description": "Bridges or culverts at creeks and sloughs that keep a dry path under the road, so otters do not climb onto the highway."
    },
    "fencing": {
      "name": "Directional fencing",
      "description": "Fencing along the highway that keeps animals off the road and guides them toward the crossing structure."
    }
  },
